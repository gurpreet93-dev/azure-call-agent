# --- Required: where the model runs ---
# azure-openai = GPT deployed in Microsoft Foundry (Azure OpenAI)   <- default
# foundry      = Claude deployed in Microsoft Foundry
# anthropic    = Claude on the Anthropic API (fallback if Azure is unavailable)
LLM_PROVIDER=azure-openai

# Both Azure options: resource name is the <name> in https://<name>.services.ai.azure.com
# (Foundry portal -> your project -> Home). The API key is on the same page.
FOUNDRY_RESOURCE=
FOUNDRY_API_KEY=

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# The DEPLOYMENT name you chose when deploying the model (often the model name)
AGENT_MODEL=gpt-4o
# Claude only (ignored for GPT). Haiku 5.5 thinks before replying by default; off keeps
# phone replies fast. For Haiku 4.5 set AGENT_THINKING=model-default and leave AGENT_EFFORT blank.
AGENT_THINKING=off
AGENT_EFFORT=low

SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional: public URL Twilio can reach (ngrok etc.) ---
PUBLIC_BASE_URL=https://your-subdomain.ngrok.app
# Set to validate X-Twilio-Signature on /voice/* webhooks
TWILIO_AUTH_TOKEN=

# --- Optional: Microsoft Graph (real Outlook calendar + email) ---
# Leave blank to use the built-in mock calendar + outbox (great for demos).
# App registration needs application permissions: Calendars.ReadWrite, Mail.Send
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Where the SQLite DB lives
DATABASE_PATH=data/app.db

# --- Optional: Pinecone (retrieval for large knowledge bases) ---
PINECONE_API_KEY=
PINECONE_INDEX=call-agent-kb
# KBs at or below this many tokens go straight into the prompt; above it -> Pinecone
KB_FULL_CONTEXT_MAX_TOKENS=30000

# Chunking for retrieval mode (choose with scripts/chunking_experiment.py; see docs/chunking-playbook.md)
CHUNK_METHOD=headings        # fixed | sentence | recursive | headings
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP=0
CHUNK_CONTEXT=path           # none | path | llm (llm = one Claude call per chunk at upload)
