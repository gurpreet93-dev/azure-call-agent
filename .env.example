# --- The agent (instructions + knowledge live in Microsoft Foundry) ---
# Foundry portal -> your project -> Home -> "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://voice-agent-gurpreet.services.ai.azure.com/api/projects/voice-agent
# The name you gave the agent in Foundry (Build -> Agents)
FOUNDRY_AGENT_NAME=clearview-glass-agent
# Sign-in to the agent is Microsoft Entra ID, not a key. On your own computer a browser window opens
# to sign in the first time; in Codespaces run  az login --use-device-code  first.

# --- Reply voice: Azure Speech on the same Foundry resource ---
# The API key from the Foundry Home page. Leave blank if it's set as the Codespaces secret FOUNDRY_API_KEY.
SPEECH_KEY=
SPEECH_REGION=eastus2
# One multilingual voice speaks every language in the picker
SPEECH_VOICE=en-US-AvaMultilingualNeural

# --- Website only: require this password (any username). Leave blank when running on your own computer.
APP_PASSWORD=
